{
  "name": "@pi-desktop/desktop",
  "version": "0.14.9",
  "desktopName": "pigo-desktop.desktop",
  "private": true,
  "description": "pigo-desktop renderer + Tauri shell (the desktop app; Electron was removed)",
  "homepage": "https://gitee.com/harvey_danny/pi-agent-go",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "app": "pnpm run build && cargo build --release -p pigo-desktop --manifest-path ../../Cargo.toml --features custom-protocol",
    "app:release": "pnpm run app && cp ../desktop-tauri/src-tauri/../../target/release/pigo-desktop.exe ./pigo-desktop.exe"
  },
  "dependencies": {},
  "devDependencies": {
    "@pi-desktop/i18n": "workspace:*",
    "@pi-desktop/plugin-devkit": "workspace:*",
    "@pi-desktop/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "dompurify": "^3.4.13",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "pinyin-pro": "3.29.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
