{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "apps/desktop-tauri/src/features/app/**/*.ts",
      "apps/desktop-tauri/src/features/app/**/*.tsx",
      "apps/desktop-tauri/src/features/chat/composer/**/*.ts",
      "apps/desktop-tauri/src/features/chat/composer/**/*.tsx",
      "apps/desktop-tauri/src/features/plugins/**/*.ts",
      "apps/desktop-tauri/src/features/plugins/**/*.tsx",
      "apps/desktop-tauri/src/features/settings/**/*.ts",
      "apps/desktop-tauri/src/features/settings/**/*.tsx",
      "apps/desktop-tauri/electron/main/runtime/session-launch.ts",
      "apps/desktop-tauri/electron/main/ipc/workspace-ipc.ts",
      "packages/shared/src/types/**/*.ts",
      "scripts/check-architecture.mjs",
      "scripts/e2e/*.mjs"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  }
}